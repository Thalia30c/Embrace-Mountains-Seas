/* 仓库页：暗金古风，与牌组页一致 */
.page-bg {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
}
.bg-image {
  width: 100%;
  height: 100%;
}
.wh-page {
  position: relative;
  z-index: 1;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 16rpx 16rpx 16rpx;
}
.wh-header {
  flex: 0 0 auto;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #ffd98a;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx #000;
  padding: 12rpx 0;
  font-family: "STKaiti", "KaiTi", "Songti SC", serif;
}

/* 筛选栏 */
.wh-filters {
  flex: 0 0 auto;
  background: rgba(20, 14, 6, 0.78);
  border: 2rpx solid #e6c16b;
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 12rpx;
}
.filter-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin: 6rpx 0;
}
.filter-label {
  color: #e6c16b;
  font-size: 24rpx;
  margin-right: 14rpx;
  width: 60rpx;
}
.chip {
  padding: 8rpx 22rpx;
  margin: 6rpx 10rpx 6rpx 0;
  font-size: 24rpx;
  color: #f0e2c0;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(230, 193, 107, 0.5);
  border-radius: 30rpx;
}
.chip.active {
  background: linear-gradient(180deg, #e6c16b, #b8862f);
  color: #2a1c06;
  font-weight: bold;
  border-color: #ffe9a8;
}

/* 上方卡牌库：限定高度，内部可滑动 */
.wh-library {
  flex: 0 0 38vh;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.wh-card.selected .wh-inner {
  border-color: #ffffff;
  box-shadow: 0 0 16rpx rgba(255, 255, 255, 0.85);
}

/* 下方展示区 */
.wh-stage {
  flex: 1 1 auto;
  background: rgba(20, 14, 6, 0.78);
  border: 2rpx solid #e6c16b;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 12rpx;
  box-sizing: border-box;
}
.stage-hint {
  color: #f0e2c0;
  font-size: 26rpx;
}
/* 播放中的视频：铺满整个屏幕（视觉全屏），盖住上库与下展示区；播完卸载即回到仓库页 */
.wh-video {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 999;
  background: #000;
}
.stage-detail {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 100%;
}
.detail-side {
  flex: 0 0 30%;
  display: flex;
  flex-direction: column;
  padding: 10rpx;
  box-sizing: border-box;
}
.detail-right {
  align-items: center;
}
.side-title {
  color: #ffd98a;
  font-size: 26rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(230, 193, 107, 0.5);
  padding-bottom: 8rpx;
}
.attr-row {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #f0e2c0;
  margin: 8rpx 0;
}
.attr-k { opacity: 0.8; }
.attr-v { color: #ffd98a; font-weight: bold; }
.detail-center {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}
.detail-img {
  width: 260rpx;
  height: 340rpx;
  border: 3rpx solid #e6c16b;
  border-radius: 12rpx;
  box-shadow: 0 0 30rpx rgba(212, 184, 120, 0.7);
}
.detail-name {
  color: #ffd98a;
  font-size: 26rpx;
  margin-top: 10rpx;
  text-align: center;
}
.skill-name {
  color: #ffd98a;
  font-size: 24rpx;
  font-weight: bold;
  text-align: center;
}
.skill-desc {
  color: #9c8a5e;
  font-size: 20rpx;
  text-align: center;
  margin-top: 10rpx;
}
.replay-btn {
  margin-top: 18rpx;
  padding: 10rpx 30rpx;
  font-size: 22rpx;
  color: #2a1c06;
  font-weight: bold;
  background: linear-gradient(180deg, #e6c16b, #b8862f);
  border-radius: 30rpx;
  border: 2rpx solid #ffe9a8;
}
.replay-btn:active {
  opacity: 0.85;
}
.err-note {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #9c8a5e;
  text-align: center;
}
.wh-grid {
  display: flex;
  flex-wrap: wrap;
  padding-bottom: 30rpx;
}
.wh-card {
  width: 25%;
  box-sizing: border-box;
  padding: 10rpx;
}
.wh-inner {
  position: relative;
  border: 2rpx solid #e6c16b;
  border-radius: 10rpx;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(60, 42, 16, 0.90), rgba(24, 16, 4, 0.92));
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.4);
}
.wh-img {
  width: 100%;
  height: 230rpx;
  display: block;
}
.wh-badges {
  position: absolute;
  top: 4rpx; left: 4rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}
.badge {
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  color: #ffffff;
  text-shadow: 0 1rpx 2rpx #000;
}
.lv-huang { background: #c9a227; }
.lv-xuan { background: #5b6e8c; }
.kd-attack { background: #b5462f; }
.kd-defense { background: #2f6fb5; }
.kd-magic { background: #7a3fb5; }
.cmp { background: #b8862f; }
.wh-name {
  text-align: center;
  font-size: 20rpx;
  color: #f0e2c0;
  padding: 6rpx 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.wh-empty {
  text-align: center;
  color: #f0e2c0;
  font-size: 26rpx;
  padding: 60rpx 0;
}
