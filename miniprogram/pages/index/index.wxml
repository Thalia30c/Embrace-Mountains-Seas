<view class="container">
  <!-- 顶部玩家信息 -->
  <view class="header">
    <block wx:if="{{isLogin}}">
      <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
      <view class="user-meta">
        <view class="nickname">{{userInfo.nickname}}</view>
        <view class="text-muted">段位 {{userInfo.rank}} · 金币 {{userInfo.coins}}</view>
      </view>
    </block>
    <block wx:else>
      <view class="user-meta">
        <view class="nickname">未登录</view>
        <view class="text-muted">登录后即可开始对战</view>
      </view>
      <button class="btn-mini" bindtap="goLogin">登录</button>
    </block>
  </view>

  <!-- 功能入口 -->
  <view class="menu">
    <view class="menu-item" bindtap="goHall">
      <view class="menu-title">对战大厅</view>
      <view class="text-muted">创建房间 / 加入房间</view>
    </view>
    <view class="menu-item" bindtap="goDeck">
      <view class="menu-title">我的牌组</view>
      <view class="text-muted">配置出战卡组</view>
    </view>
    <view class="menu-item" bindtap="goProfile">
      <view class="menu-title">个人中心</view>
      <view class="text-muted">战绩与排行榜</view>
    </view>
  </view>

  <view class="tip">
    <view class="tip-title">游戏规则</view>
    <view class="text-muted">每回合获得 5 点费用，卡牌费用不能超过剩余费用。攻击卡对对手造成伤害，防御卡回复自身血量，技能卡回复生命。对手血量归零即获胜。</view>
  </view>
</view>
