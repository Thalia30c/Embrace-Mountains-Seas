.header {
  display: flex;
  align-items: center;
  background: #1f2a44;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #3a4763;
  margin-right: 24rpx;
}

.user-meta {
  flex: 1;
}

.nickname {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.header .text-muted {
  color: #a8b0c4;
}

.btn-mini {
  background: #ffffff;
  color: #1f2a44;
  font-size: 26rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  margin: 0;
}

.btn-mini::after {
  border: none;
}

.menu-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
}

.menu-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.tip {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
}

.tip-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}
