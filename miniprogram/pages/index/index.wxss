/* pages/index/index.wxss
   山海异兽卡牌对战系统 · 首页样式（暗金国风，按钮全 CSS 实现）
   配色规范：底色 #121216 · 主文字 #f5e7c1 · 边框 #b89b58
   设计基准 750rpx 竖屏，自定义导航栏
*/

page {
  background-color: #121216;
  height: 100%;
}

.home {
  position: relative;
  width: 750rpx;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

.bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 100vh;
  z-index: 1;
}

.bg-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 750rpx;
  height: 100vh;
  z-index: 2;
  background: linear-gradient(180deg, rgba(18, 18, 22, 0.15) 0%, rgba(18, 18, 22, 0.45) 45%, rgba(18, 18, 22, 0.92) 100%);
}

/* 区域1：顶部标题 + 资源 */
.top {
  position: relative;
  z-index: 3;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 100rpx 40rpx 0;
}

.top-left {
  display: flex;
  flex-direction: column;
}

.main-title {
  font-size: 68rpx;
  font-weight: 700;
  color: #f5e7c1;
  letter-spacing: 8rpx;
  text-shadow: 0 0 20rpx rgba(212, 184, 120, 0.7);
  font-family: "STKaiti", "KaiTi", serif;
}

.sub-title {
  font-size: 24rpx;
  color: #b9a06a;
  letter-spacing: 12rpx;
  margin-top: 10rpx;
}

.tag {
  margin-top: 18rpx;
  font-size: 20rpx;
  color: rgba(245, 231, 193, 0.55);
  letter-spacing: 6rpx;
  align-self: flex-start;
}

.currency {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
  padding-right: 8rpx;
}

.cur-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.cur-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 3rpx solid #e8d9a8;
  box-shadow: 0 0 16rpx rgba(232, 217, 168, 0.5);
  background: #0d1117;
}

.cur-num {
  font-size: 22rpx;
  color: #e8cf94;
  text-shadow: 0 0 8rpx rgba(0, 0, 0, 0.8);
}

/* 区域2：核心主按钮（抽卡/战斗） */
.main-btns {
  position: relative;
  z-index: 3;
  display: flex;
  justify-content: center;
  gap: 70rpx;
  margin-top: 290rpx;
}

.big-btn {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(201, 165, 94, 0.75);
  box-shadow: 0 0 46rpx rgba(212, 184, 120, 0.8), 0 0 90rpx rgba(212, 184, 120, 0.35);
  transition: transform 0.28s ease, box-shadow 0.28s ease;
}

.btn-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.btn-inner {
  position: relative;
  z-index: 1;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(245, 231, 193, 0.45);
  background: rgba(10, 9, 8, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.btn-text {
  font-size: 52rpx;
  font-weight: 700;
  color: #f5e7c1;
  letter-spacing: 4rpx;
  font-family: "STKaiti", "KaiTi", serif;
  text-shadow: 0 0 16rpx rgba(212, 184, 120, 0.8);
}

.btn-sub {
  font-size: 26rpx;
  color: #e8d59a;
  margin-top: 8rpx;
  letter-spacing: 3rpx;
  text-shadow: 0 0 10rpx rgba(212, 184, 120, 0.6);
}

.big-btn-press {
  transform: scale(0.94);
  opacity: 0.85;
}

/* 核心主按钮 hover：浮起效果 */
.big-btn:hover {
  transform: translateY(-18rpx) scale(1.04);
  box-shadow: 0 30rpx 70rpx rgba(212, 184, 120, 0.9), 0 0 120rpx rgba(212, 184, 120, 0.55);
}

/* 区域3：欢迎面板 */
.welcome {
  position: relative;
  z-index: 3;
  margin: 110rpx auto 0;
  width: 620rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 0 24rpx rgba(212, 184, 120, 0.35);
}

.welcome-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.welcome-text {
  position: relative;
  z-index: 1;
  font-size: 32rpx;
  color: #f5e7c1;
  letter-spacing: 6rpx;
  font-family: "STKaiti", "KaiTi", serif;
  text-shadow: 0 0 12rpx rgba(212, 184, 120, 0.6);
}

/* 中部云雾装饰（填补欢迎面板与底部按钮之间的留白） */
.fog {
  position: absolute;
  left: 0;
  bottom: 220rpx;
  width: 750rpx;
  height: 260rpx;
  z-index: 2;
  pointer-events: none;
  background:
    radial-gradient(ellipse 55% 40% at 22% 68%, rgba(214, 226, 244, 0.13) 0%, rgba(214, 226, 244, 0) 100%),
    radial-gradient(ellipse 48% 36% at 74% 46%, rgba(214, 226, 244, 0.11) 0%, rgba(214, 226, 244, 0) 100%),
    radial-gradient(ellipse 62% 30% at 48% 88%, rgba(214, 226, 244, 0.08) 0%, rgba(214, 226, 244, 0) 100%);
}

/* 区域4：底部次级按钮（卡组/商店/个人） */
.bottom-bar {
  position: absolute;
  left: 0;
  bottom: 170rpx;
  width: 750rpx;
  z-index: 3;
  display: flex;
  justify-content: center;
  gap: 120rpx;
  padding: 30rpx 0;
  background: linear-gradient(180deg, rgba(18, 18, 22, 0) 0%, rgba(18, 18, 22, 0.75) 60%, rgba(18, 18, 22, 0.9) 100%);
}

.mini-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  transition: transform 0.28s ease, box-shadow 0.28s ease;
}

/* 底部次级按钮 hover：与核心按钮一致的浮起效果 */
.mini-btn:hover {
  transform: translateY(-14rpx) scale(1.05);
  box-shadow: 0 24rpx 56rpx rgba(212, 184, 120, 0.8), 0 0 80rpx rgba(212, 184, 120, 0.45);
}

.mini-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid #f5e7c1;
  box-shadow: 0 0 24rpx rgba(212, 184, 120, 0.6);
  background: #0d1117;
}

.mini-text {
  font-size: 26rpx;
  color: #f5e7c1;
  letter-spacing: 3rpx;
  text-shadow: 0 0 8rpx rgba(0, 0, 0, 0.8);
}

.mini-btn-press {
  transform: scale(0.92);
  opacity: 0.85;
}

/* 区域5：免责备注 */
.notice {
  position: absolute;
  left: 0;
  bottom: 30rpx;
  width: 750rpx;
  z-index: 3;
  text-align: center;
  font-size: 20rpx;
  color: rgba(245, 231, 193, 0.5);
  letter-spacing: 1rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
}
