<view class="login-wrap">
  <view class="logo">🃏</view>
  <view class="title">卡牌竞技</view>
  <view class="text-muted subtitle">登录后开始你的对战之旅</view>

  <view class="form">
    <input class="input" placeholder="用户名" value="{{username}}" bindinput="onInput" data-field="username" />
    <input class="input" password placeholder="密码" value="{{password}}" bindinput="onInput" data-field="password" />
    <input wx:if="{{isRegister}}" class="input" placeholder="昵称（选填）" value="{{nickname}}" bindinput="onInput" data-field="nickname" />

    <button class="btn-primary" bindtap="onLogin">{{isRegister ? '注 册' : '登 录'}}</button>
    <button class="btn-secondary" bindtap="onWxLogin">微信一键登录</button>
    <view class="toggle" bindtap="toggleMode">
      {{isRegister ? '已有账号？去登录' : '没有账号？去注册'}}
    </view>
  </view>
</view>
