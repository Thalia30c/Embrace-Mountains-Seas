<view class="battle-wrap">
  <!-- 加载中 / 加载失败：状态未拿到时显示，避免整页空白 -->
  <view wx:if="{{!state}}" class="state-box">
    <view class="text-muted">对局加载中...</view>
    <view wx:if="{{loadFailed}}" class="text-muted err">加载失败，请检查后端服务是否已启动</view>
    <button class="btn-secondary" bindtap="pollState">重新加载</button>
  </view>

  <block wx:else>
  <!-- 顶部回合信息 -->
  <view class="top-bar">
    <view class="round">第 {{state.round}} 回合</view>
    <view class="text-muted">费用上限 {{state.maxCost}}</view>
  </view>

  <!-- 玩家状态 -->
  <view class="players">
    <view wx:for="{{players}}" wx:key="userId"
          class="player {{item.userId === currentTurnUserId ? 'active' : ''}}">
      <view class="p-name">
        {{item.nickname}}
        <text wx:if="{{item.userId === currentTurnUserId}}" class="badge">出牌中</text>
      </view>
      <view class="p-hp">❤ {{item.hp}}</view>
      <view class="text-muted">
        费用 {{item.cost}} · 手牌 {{item.handCount}}
      </view>
    </view>
  </view>

  <!-- 结算遮罩 -->
  <view wx:if="{{finished}}" class="result-mask">
    <view class="result-box">
      <view class="result-title">{{winnerName ? winnerName + ' 获胜' : '平局'}}</view>
      <button class="btn-primary" bindtap="goHall">返回大厅</button>
    </view>
  </view>

  <!-- 手牌区 -->
  <view class="hand-area">
    <view class="hand-title">我的手牌</view>
    <scroll-view scroll-x class="hand-scroll" wx:if="{{myHand.length > 0}}">
      <view class="hand-row">
        <view wx:for="{{myHand}}" wx:key="id"
              class="card-item {{selectedCardId === item.id ? 'selected' : ''}}"
              data-cardid="{{item.id}}" bindtap="onSelectCard">
          <view class="c-name">{{item.name}}</view>
          <view class="c-type {{item.type}}">{{item.type === 'attack' ? '攻击' : (item.type === 'defense' ? '防御' : '技能')}}</view>
          <view class="c-stat">攻 {{item.attack}} / 防 {{item.defense}}</view>
          <view class="c-cost">费用 {{item.cost}}</view>
        </view>
      </view>
    </scroll-view>
    <view wx:else class="text-muted empty-hand">手牌已空</view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions" wx:if="{{!finished}}">
    <button class="btn-act" bindtap="onDraw">抽牌</button>
    <button class="btn-act primary" bindtap="onPlay">出牌</button>
    <button class="btn-act" bindtap="onPass">过牌</button>
    <button class="btn-act danger" bindtap="onSurrender">认输</button>
  </view>
  <view wx:if="{{!isMyTurn && !finished}}" class="turn-tip">等待对手出牌...</view>
  </block>
</view>
