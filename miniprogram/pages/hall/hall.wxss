.toolbar {
  margin-bottom: 24rpx;
}

.join-box {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.input-inline {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  margin-bottom: 0;
  margin-right: 16rpx;
  font-size: 26rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
}

.room-item {
  padding: 28rpx 24rpx;
}

.room-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.room-right {
  text-align: right;
}

.room-count {
  font-size: 34rpx;
  font-weight: bold;
  color: #1f2a44;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog {
  width: 600rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 32rpx;
}

.picker {
  background-color: #f2f3f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: 24rpx;
}
