<view class="page">
  <image class="bg" src="/assets/bg-picka.jpg" mode="aspectFill"></image>
  <view class="scrim"></view>

  <view class="wrap">
    <view class="head">
      <view class="title">山海遁甲</view>
      <view class="sub">功能展示</view>
      <view class="user">
        <text class="ava">{{nickname.charAt(0)}}</text>
        <text class="nick">{{nickname}}</text>
        <text class="meta">{{rank}} · {{score}} 分</text>
      </view>
      <view class="logout" bindtap="logout">退出登录</view>
    </view>

    <view class="grid">
      <view wx:for="{{items}}" wx:key="key"
            class="feat {{item.main?'main':''}}"
            data-url="{{item.url}}" bindtap="go">
        <view class="feat-main">{{item.label}}</view>
        <view class="feat-desc">{{item.desc}}</view>
        <view class="feat-go">进入 ›</view>
      </view>
    </view>
  </view>
</view>
