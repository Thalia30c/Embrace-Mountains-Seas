/* pages/home/home.wxss —— 功能展示页（深色水墨 + 描金，与战斗页同风格） */
page { background: #121216; }
.page { position: relative; height: 100vh; box-sizing: border-box; overflow: hidden; color: #f5e7c1;
  font-family: "STKaiti", "KaiTi", serif; }
.bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: .55; }
.scrim { position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(10,8,14,.72), rgba(10,8,14,.55) 40%, rgba(10,8,14,.82)); }
.wrap { position: relative; z-index: 2; height: 100%; box-sizing: border-box;
  padding: 60rpx 40rpx 50rpx; display: flex; flex-direction: column; }

/* 头部 */
.head { text-align: center; margin-bottom: 40rpx; }
.title { font-size: 62rpx; color: #f6e6b0; letter-spacing: 12rpx; font-weight: 700;
  text-shadow: 0 0 24rpx rgba(212,184,120,.5); }
.sub { font-size: 26rpx; color: #d4b878; letter-spacing: 8rpx; margin-top: 6rpx; }
.user { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-top: 22rpx; }
.ava { width: 52rpx; height: 52rpx; line-height: 52rpx; border-radius: 50%; text-align: center;
  background: rgba(246,230,176,.16); border: 2rpx solid #d4b878; color: #f6e6b0; font-size: 26rpx; }
.nick { font-size: 28rpx; color: #f5e7c1; }
.meta { font-size: 22rpx; color: #a89a7c; }
.logout { display: inline-block; margin-top: 16rpx; padding: 6rpx 22rpx; font-size: 22rpx;
  color: #a89a7c; border: 2rpx solid rgba(212,184,120,.35); border-radius: 20rpx; }

/* 功能入口 */
.grid { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(2, 1fr);
  gap: 20rpx; align-content: start; overflow-y: auto; }
.feat { box-sizing: border-box; padding: 26rpx 24rpx; border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(30,26,38,.85), rgba(18,17,24,.9));
  border: 2rpx solid rgba(212,184,120,.35); box-shadow: 0 10rpx 26rpx rgba(0,0,0,.45); }
.feat:active { transform: scale(.98); }
.feat-main { font-size: 32rpx; color: #f6e6b0; letter-spacing: 4rpx; }
.feat-desc { font-size: 21rpx; color: #a89a7c; margin-top: 8rpx; line-height: 1.5; }
.feat-go { font-size: 21rpx; color: #d4b878; margin-top: 14rpx; text-align: right; }

/* 主功能：战斗 —— 占整行，更醒目 */
.feat.main { grid-column: 1 / -1; padding: 40rpx 32rpx;
  border-color: #b89b58; box-shadow: 0 12rpx 30rpx rgba(0,0,0,.5), 0 0 40rpx rgba(184,155,88,.25);
  background: linear-gradient(180deg, rgba(48,40,26,.92), rgba(20,17,24,.94)); }
.feat.main .feat-main { font-size: 46rpx; letter-spacing: 12rpx; text-align: center;
  text-shadow: 0 0 20rpx rgba(212,184,120,.45); }
.feat.main .feat-desc { text-align: center; font-size: 23rpx; }
.feat.main .feat-go { text-align: center; font-size: 24rpx; margin-top: 20rpx; }
