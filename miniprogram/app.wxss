/* app.wxss 全局样式 */
page {
  background-color: #f5f6fa;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #2c3040;
}

.container {
  padding: 24rpx;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 42, 68, 0.06);
}

/* 主按钮 */
.btn-primary {
  background-color: #1f2a44;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  height: 88rpx;
  text-align: center;
  margin-top: 24rpx;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background-color: #ffffff;
  color: #1f2a44;
  border: 2rpx solid #1f2a44;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 84rpx;
  height: 88rpx;
  text-align: center;
  margin-top: 24rpx;
}

.btn-secondary::after {
  border: none;
}

/* 通用输入框 */
.input {
  background-color: #f2f3f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: 24rpx;
}

.text-muted {
  color: #8a90a2;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
